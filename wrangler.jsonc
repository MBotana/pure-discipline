{
  "name": "pure-discipline",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lr66", "database_id": "c2508e50-1997-4194-895b-d4185f986af2" }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
